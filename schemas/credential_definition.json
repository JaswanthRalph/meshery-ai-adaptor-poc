{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AI Provider Credential Definition",
  "description": "Schema for AI provider credential payloads. Secret values are encrypted at rest and never returned to API clients.",
  "type": "object",
  "required": ["name", "kind"],
  "properties": {
    "name": {
      "type": "string",
      "description": "Human-readable credential name"
    },
    "kind": {
      "type": "string",
      "enum": ["openai", "anthropic", "ollama", "azure-openai"],
      "description": "Associated provider kind"
    },
    "secret": {
      "type": "object",
      "description": "Secret key-value pairs. NEVER returned in API responses.",
      "properties": {
        "api_key": {
          "type": "string",
          "description": "Provider API key",
          "writeOnly": true
        },
        "tenant_id": {
          "type": "string",
          "description": "Azure tenant ID (Azure OpenAI only)",
          "writeOnly": true
        }
      },
      "additionalProperties": { "type": "string" }
    }
  }
}
